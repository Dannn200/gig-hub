# Copy to .env and edit
NODE_ENV=development
PORT=4000

# REQUIRED in production: long random string (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me-in-production

# SQLite file (use :memory: for throw-away runs)
DB_PATH=./data/gighub.db

# Comma-separated list of frontend origins allowed by CORS (e.g. your Netlify URL)
CORS_ORIGIN=http://localhost:5500,http://localhost:3000,http://127.0.0.1:5500

# Optional: restrict sign-ups to these email domains (comma-separated, empty = allow any)
# e.g. ALLOWED_EMAIL_DOMAINS=iitd.ac.in,du.ac.in
ALLOWED_EMAIL_DOMAINS=

# Timezone offset applied to gig date + time inputs
APP_UTC_OFFSET=+05:30

# Google OAuth Client ID (optional, leave blank for demo/mock mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Minimum wallet withdrawal in rupees
MIN_WITHDRAWAL=100

# Also serve the static HTML frontend from the project root (handy for local dev)
SERVE_FRONTEND=false
